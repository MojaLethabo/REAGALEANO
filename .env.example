# Copy to .env.local and fill in.
# 32+ random characters: openssl rand -base64 48
SESSION_SECRET=
# Owner account created on first start (change the password after first login)
OWNER_NAME=Owner
OWNER_EMAIL=
OWNER_PASSWORD=
# Optional: email the owner when a request arrives (https://resend.com)
RESEND_API_KEY=
